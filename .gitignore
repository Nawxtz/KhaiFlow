# --- Python & Environment ---
__pycache__/
*.py[cod]
*.pyc
*.pyo
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# --- Environment Secrets (CRITICAL) ---
# Never push your local environment variables!
.env
*.env
!.env.example

# --- Node ---
node_modules/
.next/
out/
*.tsbuildinfo

# --- Playwright ---
playwright-report/
playwright-screenshots/
test-results/

# --- Database / Persistent Data ---
# Exclude database files, especially if they contain live data or session locks
*.db
*.db-shm
*.db-wal
*.sqlite3

# --- Docker ---
# Exclude build artifacts or local secrets if they end up in root
.dockerignore

# --- System & IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Logs ---
logs/
*.log