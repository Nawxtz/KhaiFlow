# ==============================================================================
# Thai Smart Address - Backend Environment Configuration (.env.example)
# Authoritative reference: reference_settings.md & backend/app/core/config.py
# NOTE: Do NOT commit production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Multi-Tenancy
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/thaismart
DEFAULT_SHOP_ID=default
SHOP_ID=
SHOP_PROMPTPAY_ID=

# ------------------------------------------------------------------------------
# 2. LINE Messaging API Integration
# ------------------------------------------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ------------------------------------------------------------------------------
# 3. LLM & NLP Engine (OpenRouter)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
LLM_ENABLED=true
LLM_MODEL_MAIN=gemini/gemini-flash
LLM_MODEL_BACKUP=openai/gpt-4o-mini
LLM_ESCALATE_CONFIDENCE=0.8

# ------------------------------------------------------------------------------
# 4. Google Sheets Catalog & Fulfillment Ingest
# ------------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEET_ID=
SHEET_ID=
FULFILLMENT_SHEET_ID=
GOOGLE_SHEET_INVENTORY_RANGE=Inventory!A1:G
SHEET_SYNC_INTERVAL_SECONDS=60
SHEET_INGEST_SELLER_OVERRIDE=true
CACHE_TTL_SECONDS=60

# ------------------------------------------------------------------------------
# 5. Payment, QR & Webhook Security
# ------------------------------------------------------------------------------
PAYMENT_QR_SECRET=
GATEWAY_WEBHOOK_SECRET=
PAYMENT_TOLERANCE_TYPE=abs
PAYMENT_TOLERANCE_VALUE=1
UNDERPAYMENT_POLICY=topup
OVERPAYMENT_POLICY=refund_diff

# ------------------------------------------------------------------------------
# 6. Verification & Escalation (Option A / Option B / Filter C)
# ------------------------------------------------------------------------------
VERIFICATION_MODE=B
FILTER_C_ENABLED=true
C_AUTOCONFIRM_ENABLED=false
C_AUTOCONFIRM_PER_ORDER_CAP=500
C_AUTOCONFIRM_PER_BUYER_DAILY_THB=1500
C_AUTOCONFIRM_PER_BUYER_DAILY_COUNT=3
C_AUTOCONFIRM_PER_SHOP_DAILY_THB=20000
C_AUTOCONFIRM_PER_SHOP_DAILY_COUNT=100
C_AUTOCONFIRM_COOLDOWN_MINUTES=30
C_AUTOCONFIRM_AUDIT_SAMPLE_PCT=10
C_AUTOCONFIRM_KILLSWITCH_FLAGS=3
HUMAN_APPROVAL_THRESHOLD=1000
AUTO_APPROVE_SMALL_VIA_A_CAP=500
ESC_REMINDER_MINUTES=10
ESC_URGENT_BACKUP_MINUTES=15
ESC_AUTO_ACTION_MINUTES=30
ESC_HARD_CEILING_HOURS=24

# ------------------------------------------------------------------------------
# 7. Stock Reservation & Timeouts
# ------------------------------------------------------------------------------
RESERVATION_TTL_SECONDS=600
TTL_AWAITING_PAYMENT_MINUTES=30
TTL_REVIVAL_CONFIRM_MINUTES=10

# ------------------------------------------------------------------------------
# 8. Portal Auth & Security
# ------------------------------------------------------------------------------
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT=5/min
MFA_ENABLED=false

# ------------------------------------------------------------------------------
# 9. PDPA Data Privacy & Retention
# ------------------------------------------------------------------------------
RETENTION_MONTHS=12
CONSENT_REQUIRED=true

# ------------------------------------------------------------------------------
# 10. Operations & Reconciliation
# ------------------------------------------------------------------------------
INTEGRITY_JOB_INTERVAL_MINUTES=60

# ------------------------------------------------------------------------------
# 11. Logistics & Export
# ------------------------------------------------------------------------------
CARRIER_CONFIGS={}
EXPORT_INCLUDE_STATUSES=confirmed,fulfilled

# ------------------------------------------------------------------------------
# 12. Buyer & Portal UX / Localization
# ------------------------------------------------------------------------------
CAROUSEL_PAGE_SIZE=8
ADDRESS_BOOK_ENABLED=true
UI_DEFAULT_BUYER_LANGUAGE=th
UI_BUYER_LANGUAGE_SELECTABLE=true
UI_DEFAULT_PORTAL_LANGUAGE=en
UI_DEFAULT_THEME=system
UI_THEME_SELECTABLE=true

